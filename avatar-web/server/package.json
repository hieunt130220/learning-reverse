{
  "name": "avatar-web-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "gen-key": "tsx src/tools/gen-key.ts",
    "captcha:collect": "tsx src/tools/captcha-collector.ts",
    "fishing:probe": "tsx src/tools/fishing-probe.ts",
    "fishing:png-analyze": "tsx src/tools/fishing-png-analyze.ts",
    "fishing:local-shadow-cycle": "tsx src/tools/fishing-local-shadow-cycle.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
